# Copy to .env.local. Never commit the real browser-side AK or production secrets.
FRONTEND_BAIDU_MAP_AK=
DEMO_HTTP_PORT=8088
MEDIA_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1

MYSQL_DATABASE=zhixun_demo
MYSQL_USER=zhixun
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DEMO_COOKIE_SECRET=replace-with-at-least-32-random-characters

DEMO_MAX_ACTIVE_SESSIONS=12
DEMO_MAX_QUEUE_SIZE=100
DEMO_SESSION_DURATION_SECONDS=180
DEMO_DISCONNECT_EXPIRY_SECONDS=75
