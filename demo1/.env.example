# Copy to .env.local. Never commit the real browser-side AK or production secrets.
FRONTEND_BAIDU_MAP_AK=
FRONTEND_STATIC_ASSET_BASE=https://java-tongueman.oss-cn-beijing.aliyuncs.com/%E5%9F%8E%E5%B8%82%E7%A9%BA%E5%9C%B0%E5%8D%8F%E5%90%8C%E7%89%A9%E6%B5%81%E8%BF%90%E8%90%A5%E6%B2%99%E7%9B%98
DEMO_HTTP_PORT=8088
BACKEND_HTTP_PORT=8095
MEDIA_HTTP_PORT=8889
MYSQL_PORT=3306
MQTT_PORT=1883
MEDIA_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1

MYSQL_DATABASE=skyfleet_logistics
MYSQL_USER=skyfleet
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DEMO_COOKIE_SECRET=replace-with-at-least-32-random-characters

DEMO_MAX_ACTIVE_SESSIONS=12
DEMO_MAX_QUEUE_SIZE=100
DEMO_SESSION_DURATION_SECONDS=180
DEMO_DISCONNECT_EXPIRY_SECONDS=75
# Local Docker only. Production compose defaults this capability to false.
FLEET_DEV_PRICING_ENABLED=true

# Optional. Keep this server-side only; never expose it through Vite or commit a real value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=20
AI_MAX_ADVISORIES_PER_SESSION=5
AI_MIN_INTERVAL_SECONDS=10

TRAFFIC_LIGHT_SPACING_METERS=360
TRAFFIC_LIGHT_STOP_BUFFER_METERS=10
BAIDU_ROUTE_AK=
BAIDU_ROUTE_BASE_URL=https://api.map.baidu.com
BAIDU_ROUTE_CONNECT_TIMEOUT_SECONDS=3
BAIDU_ROUTE_RESPONSE_TIMEOUT_SECONDS=6
